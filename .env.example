# Example .env for Laravel Geocode Cache

# The Google Geocoding API key, used by the google driver
# GOOGLE_MAPS_GEOCODING_API_KEY=

# The adapter that looks coordinates up: google or a driver you registered
GEOCODE_CACHE_DRIVER=google

# The table that holds the cached coordinates
GEOCODE_CACHE_TABLE=geocode_cache

# The database connection of the cache table and the statistics table, empty for the default connection
# GEOCODE_CACHE_DB_CONNECTION=

# Add a "Geocode Cache" section to `php artisan about` (true/false)
# GEOCODE_CACHE_ABOUT=true

# The days a result may be used and kept, from 1 to 30 for results from Google
GEOCODE_CACHE_TTL_DAYS=29

# The decimals of a coordinate that are stored, from 0 to 7 for Google, empty for the maximum
# GEOCODE_CACHE_PRECISION=

# Store the Google place ID next to the coordinates (true/false)
GEOCODE_CACHE_STORE_PLACE_ID=true

# The cache store that holds the locks, empty for the default store
# GEOCODE_CACHE_LOCK_STORE=

# Count how often and how regularly each query hash is requested, per day (true/false)
GEOCODE_CACHE_STATISTICS_ENABLED=false

# A log channel for failed lookups and the runs of the commands, empty for no logging
# GEOCODE_CACHE_LOG_CHANNEL=

# Fetch entries that are still in use again before they expire (true/false)
GEOCODE_CACHE_REFRESH_ENABLED=false

# Also store the encrypted queries, so a refresh asks for the address again instead of the place ID (true/false)
GEOCODE_CACHE_REFRESH_STORE_QUERY=false
